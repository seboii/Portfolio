# Send only the inputs needed to build this site.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!.mise.toml
!tsconfig.json
!index.html
!vite.config.ts
!src/
!src/**
!public/
!public/**
!scripts/
!scripts/**
!.figma/
!.figma/make/
!.figma/make/site.json
!docker/
!docker/nginx.conf

# Keep local dependencies, credentials and original documents out even if
# someone later places them inside an allowed source or asset directory.
**/node_modules
**/node_modules/**
**/.git
**/.git/**
**/dist
**/dist/**
**/.prerender
**/.prerender/**
**/.env*
**/.secrets
**/.secrets/**
**/docs
**/docs/**
**/attachments
**/attachments/**
**/*.pdf
**/*.PDF
**/*.doc
**/*.docx
**/*.ppt
**/*.pptx
**/*.xls
**/*.xlsx
**/*.pem
**/*.key
