# Public production build settings. These are embedded in the static site.
VITE_SITE_URL=https://sshakho.com
VITE_ALLOW_INDEX=true

# The published web port is bound only to this computer's loopback interface.
PORTFOLIO_PORT=8080

# Contains a file path, never the tunnel token itself. Keep it outside OneDrive.
CLOUDFLARED_TOKEN_FILE=${USERPROFILE}/.cloudflared/sshakho-portfolio-token.txt
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0
